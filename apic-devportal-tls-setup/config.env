#!/bin/bash
# =============================================================================
# API Connect Developer Portal TLS Setup - Configuration
# =============================================================================
# This file contains configuration for setting up TLS certificates and
# registering the Developer Portal with the API Connect Cloud Manager.
#
# Usage: source config.env
# =============================================================================

# -----------------------------------------------------------------------------
# Static Configuration (Edit these values)
# -----------------------------------------------------------------------------

# OpenShift Configuration
export OCP_SERVER=https://api.itz-h4eig5.infra01-lb.lon04.techzone.ibm.com:6443
export OCP_USER=kubeadmin
export OCP_PASSWORD=CHANGE_ME
export OCP_TOKEN=

# API Connect Configuration
export APIC_REALM=admin/default-idp-1
export APIC_USER=admin
export APIC_PASSWORD=manager@2026
export APIC_NAMESPACE=apic-lab

# Management and Portal Instance Names
export MGMT_INSTANCE_NAME=management
export PORTAL_INSTANCE_NAME=wm-devportal

# TLS Resources Names (must be URL-safe: no spaces, lowercase, hyphens ok)
export KEYSTORE_NAME="devportal-admin-keystore"
export KEYSTORE_TITLE="Dev Portal Admin Keystore"
export KEYSTORE_SUMMARY="Dev Portal Admin default keystore"

export TRUSTSTORE_NAME="devportal-admin-truststore"
export TRUSTSTORE_TITLE="Dev Portal Admin Truststore"
export TRUSTSTORE_SUMMARY="Dev Portal Admin default truststore"

export TLS_PROFILE_NAME="devportal-admin-tls-client-profile"
export TLS_PROFILE_TITLE="Dev Portal Admin TLS Client Profile"
export TLS_PROFILE_SUMMARY="Dev Portal Admin default TLS client profile"

# TLS Configuration
# Ciphers (comma-separated list, will be converted to YAML array)
export TLS_CIPHERS="TLS_AES_256_GCM_SHA384,TLS_CHACHA20_POLY1305_SHA256,TLS_AES_128_GCM_SHA256,ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,ECDHE_ECDSA_WITH_AES_256_CBC_SHA384,ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,ECDHE_ECDSA_WITH_AES_256_CBC_SHA,ECDHE_ECDSA_WITH_AES_128_CBC_SHA,ECDHE_RSA_WITH_AES_256_GCM_SHA384,ECDHE_RSA_WITH_AES_256_CBC_SHA384,ECDHE_RSA_WITH_AES_128_GCM_SHA256,ECDHE_RSA_WITH_AES_128_CBC_SHA256,ECDHE_RSA_WITH_AES_256_CBC_SHA,ECDHE_RSA_WITH_AES_128_CBC_SHA,DHE_RSA_WITH_AES_256_GCM_SHA384,DHE_RSA_WITH_AES_256_CBC_SHA256,DHE_RSA_WITH_AES_128_GCM_SHA256,DHE_RSA_WITH_AES_128_CBC_SHA256,DHE_RSA_WITH_AES_256_CBC_SHA,DHE_RSA_WITH_AES_128_CBC_SHA,TLS_AES_128_CCM_SHA256,TLS_AES_128_CCM_8_SHA256,DHE_DSS_WITH_AES_256_GCM_SHA384,DHE_DSS_WITH_AES_256_CBC_SHA256,DHE_DSS_WITH_AES_256_CBC_SHA,RSA_WITH_AES_256_GCM_SHA384,RSA_WITH_AES_256_CBC_SHA256,RSA_WITH_AES_256_CBC_SHA,DHE_DSS_WITH_AES_128_CBC_SHA256,DHE_DSS_WITH_AES_128_CBC_SHA,RSA_WITH_AES_128_CBC_SHA,RSA_WITH_AES_128_CBC_SHA256,RSA_WITH_AES_128_GCM_SHA256"

# Protocols (comma-separated list, will be converted to YAML array)
export TLS_PROTOCOLS="tls_v1.2,tls_v1.3"

# -----------------------------------------------------------------------------
# Dynamic Configuration (Auto-discovered from OpenShift/APIC)
# -----------------------------------------------------------------------------

echo "🔍 Discovering API Connect environment..."

# Get Management Server URL from OpenShift route
if command -v oc &> /dev/null; then
  MGMT_HOST=$(oc get route "${MGMT_INSTANCE_NAME}-platform-api" -n "$APIC_NAMESPACE" -o jsonpath="{.spec.host}" 2>/dev/null || echo "")
  if [ -n "$MGMT_HOST" ]; then
    export APIC_SERVER="https://${MGMT_HOST}"
  else
    export APIC_SERVER=""
    echo "⚠️  Warning: Could not discover APIC_SERVER from OpenShift"
    echo "   Make sure you're logged into OpenShift and the management instance exists"
  fi
  
  # Get Portal URLs from OpenShift routes
  PORTAL_ADMIN_HOST=$(oc get route "${PORTAL_INSTANCE_NAME}-devportal-admin" -n "$APIC_NAMESPACE" -o jsonpath="{.spec.host}" 2>/dev/null || echo "")
  if [ -n "$PORTAL_ADMIN_HOST" ]; then
    export PORTAL_ADMIN_URL="https://${PORTAL_ADMIN_HOST}"
  else
    export PORTAL_ADMIN_URL=""
    echo "⚠️  Warning: Could not discover PORTAL_ADMIN_URL from OpenShift"
  fi
  
  PORTAL_SITE_HOST=$(oc get route "${PORTAL_INSTANCE_NAME}-devportal-web" -n "$APIC_NAMESPACE" -o jsonpath="{.spec.host}" 2>/dev/null || echo "")
  if [ -n "$PORTAL_SITE_HOST" ]; then
    export PORTAL_SITE_URL="https://${PORTAL_SITE_HOST}"
  else
    export PORTAL_SITE_URL=""
    echo "⚠️  Warning: Could not discover PORTAL_SITE_URL from OpenShift"
  fi
else
  export APIC_SERVER=""
  export PORTAL_ADMIN_URL=""
  export PORTAL_SITE_URL=""
  echo "⚠️  Warning: 'oc' command not found. Cannot auto-discover URLs."
  echo "   Please set APIC_SERVER, PORTAL_ADMIN_URL, and PORTAL_SITE_URL manually."
fi

# Get Availability Zone ID from APIC (requires login)
export AVAILABILITY_ZONE_ID=""
export AVAILABILITY_ZONE_NAME=""

if [ -n "$APIC_SERVER" ]; then
  # Try to get availability zone ID (suppress all errors)
  AVAILABILITY_ZONES=$(apic availability-zones:list \
    --org admin \
    --server "$APIC_SERVER" \
    --format json \
    --insecure-skip-tls-verify 2>/dev/null || echo "")
  
  if [ -n "$AVAILABILITY_ZONES" ]; then
    ZONE_ID=$(echo "$AVAILABILITY_ZONES" | jq -r '.results[0].id' 2>/dev/null || echo "")
    ZONE_NAME=$(echo "$AVAILABILITY_ZONES" | jq -r '.results[0].name' 2>/dev/null || echo "")
    
    if [ -n "$ZONE_ID" ] && [ "$ZONE_ID" != "null" ]; then
      export AVAILABILITY_ZONE_ID="$ZONE_ID"
      export AVAILABILITY_ZONE_NAME="$ZONE_NAME"
    else
      echo "⚠️  Warning: Could not discover Availability Zone ID"
      echo "   Make sure you're logged into APIC CLI: apic login --server \$APIC_SERVER ..."
    fi
  else
    echo "⚠️  Warning: Could not discover Availability Zone ID"
    echo "   Make sure you're logged into APIC CLI: apic login --server \$APIC_SERVER ..."
  fi
fi

# -----------------------------------------------------------------------------
# Display Configuration
# -----------------------------------------------------------------------------

echo ""
echo "📋 Configuration Loaded:"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🌐 OpenShift:"
echo "   Namespace:           $APIC_NAMESPACE"
echo ""
echo "🔧 API Connect:"
echo "   Server:              $APIC_SERVER"
echo "   Realm:               $APIC_REALM"
echo "   User:                $APIC_USER"
echo "   Management Instance: $MGMT_INSTANCE_NAME"
echo ""
echo "🌐 Developer Portal:"
echo "   Instance Name:       $PORTAL_INSTANCE_NAME"
echo "   Admin URL:           $PORTAL_ADMIN_URL"
echo "   Site URL:            $PORTAL_SITE_URL"
echo ""
echo "📍 Availability Zone:"
echo "   Name:                $AVAILABILITY_ZONE_NAME"
echo "   ID:                  $AVAILABILITY_ZONE_ID"
echo ""
echo "🔐 TLS Resources:"
echo "   Keystore:            $KEYSTORE_NAME"
echo "   Truststore:          $TRUSTSTORE_NAME"
echo "   TLS Profile:         $TLS_PROFILE_NAME"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Validate critical variables (warnings only, don't fail)
VALIDATION_FAILED=0

if [ -z "$APIC_SERVER" ] || [ "$APIC_SERVER" == "https://" ]; then
  echo "⚠️  WARNING: APIC_SERVER is not set or invalid"
  echo "   Make sure you're logged into OpenShift: oc login ..."
  VALIDATION_FAILED=1
fi

if [ -z "$PORTAL_ADMIN_URL" ] || [ "$PORTAL_ADMIN_URL" == "https://" ]; then
  echo "⚠️  WARNING: PORTAL_ADMIN_URL is not set or invalid"
  echo "   Check if Developer Portal is deployed in namespace: $APIC_NAMESPACE"
  VALIDATION_FAILED=1
fi

if [ -z "$PORTAL_SITE_URL" ] || [ "$PORTAL_SITE_URL" == "https://" ]; then
  echo "⚠️  WARNING: PORTAL_SITE_URL is not set or invalid"
  echo "   Check if Developer Portal is deployed in namespace: $APIC_NAMESPACE"
  VALIDATION_FAILED=1
fi

if [ $VALIDATION_FAILED -eq 0 ]; then
  echo "✅ Configuration validated successfully"
else
  echo ""
  echo "⚠️  Some configuration values could not be auto-discovered."
  echo "   Scripts may fail if these values are required."
  echo "   Fix the issues above and run 'source config.env' again."
fi
echo ""